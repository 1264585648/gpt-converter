---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { guides, type Guide } from '../../content/guides'

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }))
}

interface Props {
  guide: Guide
}

const { guide } = Astro.props
const relatedGuides = guides.filter((entry) => entry.topic === guide.topic && entry.slug !== guide.slug)
---

<BaseLayout
  title={`${guide.title} — Developer Guide | AuthAtlas`}
  description={guide.description}
  canonicalPath={`/guides/${guide.slug}`}
  ogImage="/mockups/formats.jpg"
>
  <div class="app-shell guide-doc-page">
    <header class="topbar"><div class="nav-inner"><a class="brand" href="/" aria-label="AuthAtlas home"><span class="brand-glyph"><i></i><b></b></span><span>AuthAtlas</span></a><nav class="nav-links"><a href="/formats">Formats</a><a href="/converter">Converter</a><a href="/compare">Compare</a><a href="/security">Security</a><a class="active" href="/guides">Guides</a><a href="https://github.com/1264585648/gpt-converter">GitHub</a></nav></div></header>

    <main class="page-shell inner-page guide-doc-main">
      <article class="content-width guide-doc-article">
        <nav class="doc-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/guides">Guides</a><span>›</span><span>{guide.title}</span></nav>

        <header class="doc-hero">
          <span class="knowledge-pill">{guide.topic} guide</span>
          <h1>{guide.title}</h1>
          <p class="direct-answer">{guide.directAnswer}</p>
        </header>

        {guide.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
            {section.code && <pre><code>{section.code}</code></pre>}
          </section>
        ))}

        <section aria-labelledby="related-topic-links">
          <h2 id="related-topic-links">Related {guide.topic} resources</h2>
          <div class="related-grid">
            {guide.related.map((link) => <a href={link.href}><strong>{link.label}</strong><span>Open resource →</span></a>)}
            {relatedGuides.map((entry) => <a href={`/guides/${entry.slug}`}><strong>{entry.title}</strong><span>{entry.description}</span></a>)}
          </div>
        </section>

        {guide.references.length > 0 && (
          <section aria-labelledby="authoritative-references">
            <h2 id="authoritative-references">Authoritative references</h2>
            <p class="reference-intro">Use upstream project documentation to verify project positioning, current channel/account behavior, and version-specific fields before importing a generated configuration.</p>
            <ul class="reference-list">
              {guide.references.map((reference) => (
                <li><a href={reference.url} rel="noreferrer">{reference.label}</a></li>
              ))}
            </ul>
          </section>
        )}
      </article>
    </main>

    <footer class="footer"><div class="content-width footer-inner"><a class="brand" href="/">AuthAtlas</a><p>{guide.topic} credential documentation and conversion guides.</p><nav><a href="/guides">All guides</a><a href="/security">Security</a></nav></div></footer>
  </div>
</BaseLayout>

<style>
  .guide-doc-main { padding-bottom: 5rem; }
  .guide-doc-article { max-width: 900px; padding-top: 2rem; }
  .doc-breadcrumb { display: flex; gap: .65rem; align-items: center; color: #8e9ab3; font-size: .9rem; margin-bottom: 3rem; }
  .doc-breadcrumb a { color: inherit; text-decoration: none; }
  .doc-hero { margin-bottom: 4rem; }
  .doc-hero h1 { font-size: clamp(2.7rem, 7vw, 5.2rem); margin: 1rem 0 1.25rem; letter-spacing: -.04em; }
  .direct-answer { max-width: 820px; font-size: 1.2rem; line-height: 1.75; color: #b9c2d6; }
  .guide-doc-article section { margin: 4rem 0; }
  .guide-doc-article h2 { margin: 0 0 1rem; font-size: 1.6rem; }
  .guide-doc-article p, .guide-doc-article li { color: #9da8bd; line-height: 1.75; }
  .guide-doc-article ul { padding-left: 1.3rem; }
  .guide-doc-article li { margin: .55rem 0; }
  pre { overflow-x: auto; padding: 1.25rem; border: 1px solid rgba(255,255,255,.08); border-radius: 14px; background: #070a12; line-height: 1.65; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1rem; }
  .related-grid a { display: flex; flex-direction: column; gap: .55rem; padding: 1.2rem; border: 1px solid rgba(255,255,255,.08); border-radius: 14px; color: inherit; text-decoration: none; background: rgba(255,255,255,.025); }
  .related-grid span { color: #8f9ab1; line-height: 1.5; font-size: .9rem; }
  .reference-intro { max-width: 760px; }
  .reference-list { padding-left: 1.2rem; }
  .reference-list a { color: #a99cff; }
</style>
